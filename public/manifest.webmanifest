{
  "id": "/play/",
  "name": "Chibi's Way Home",
  "short_name": "Chibi's Way Home",
  "description": "%HOME_DESCRIPTION%",
  "start_url": "/play/",
  "scope": "/",
  "display": "fullscreen",
  "display_override": ["fullscreen", "standalone"],
  "orientation": "landscape",
