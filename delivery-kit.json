{
  "schema": 1,
  "git": {
    "main": "main",
    "remote": "origin",
    "github": "andornaut/chibis-way-home"
  },
  "schedule": { "departures": ["20"], "timezone": "America/Toronto" },
  "gate": {
    "image": "sha256:82aa843fffc09e98f772943c1fa30b785f0936e1b125efda1d9578e5a4e57ef9",
    "install": "npm ci",
    "steps": [
      { "name": "lint", "run": "tests/container/check lint" },
      { "name": "test", "run": "tests/container/check test" },
      { "name": "build", "run": "tests/container/check build" }
    ]
  },
  "resources": { "cpus": 4, "loadLimit": 30 },
  "ci": {
    "requiredNames": ["AI attributions", "Lint", "Test"],
    "pollSeconds": 60,
    "timeoutSeconds": 1800
  },
  "deploy": { "mode": "wrangler", "skipPattern": "(\\.md$|^art/|^gameplay/)" },
  "reports": {
    "project": "Chibi",
    "scheduledTicks": true,
    "recipient": "dev-manager",
    "workerParents": ["dev-manager"]
  }
}
