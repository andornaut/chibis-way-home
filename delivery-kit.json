{
  "schema": 1,
  "git": {
    "main": "main",
    "remote": "origin",
    "github": "andornaut/chibis-way-home"
  },
  "schedule": { "departures": ["20"], "timezone": "America/Toronto" },
  "gate": {
    "image": "chibi-check:node24.21.0-shellcheck0.11.0",
    "install": "npm ci",
    "steps": [
      { "name": "check", "run": "./node_modules/.bin/tsc" },
      { "name": "lint", "run": "npm run lint" },
      {
        "name": "test",
        "run": "./node_modules/.bin/vitest run --maxWorkers=4"
      },
      { "name": "build", "run": "./node_modules/.bin/vite build" },
      {
        "name": "pairs",
        "run": "./node_modules/.bin/tsx src/tools/chunkPairs.ts verify --sample-ms 20000"
      },
      { "name": "art", "run": "node art/tools/build.ts --check" }
    ]
  },
  "resources": { "cpus": 4, "loadLimit": 30 },
  "ci": {
    "requiredNames": ["AI attributions", "Lint", "Test"],
    "pollSeconds": 60,
    "timeoutSeconds": 1800
  },
  "deploy": { "mode": "wrangler", "skipPattern": "(\\.md$|^art/|^gameplay/)" },
  "reports": {
    "project": "Chibi",
    "scheduledTicks": true,
    "recipient": "dev-manager",
    "workerParents": ["dev-manager"]
  }
}
