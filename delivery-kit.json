{
  "schema": 1,
  "git": {
    "main": "main",
    "remote": "origin",
    "github": "andornaut/chibis-way-home"
  },
  "schedule": { "departures": ["20"], "timezone": "America/Toronto" },
  "gate": {
    "image": "sha256:3ea6784b600d97020a920b94c5dc7cb05cdcc88e666628bebab4e916dbd933b2",
    "install": "npm ci",
    "steps": [
      { "name": "lint", "run": "tests/container/check lint" },
      { "name": "test", "run": "tests/container/check test" },
      { "name": "build", "run": "tests/container/check build" }
    ]
  },
  "resources": { "cpus": 4, "loadLimit": 30, "memoryMiB": 8192 },
  "ci": {
    "requiredNames": ["AI attributions", "Changes", "Lint", "Test"],
    "pollSeconds": 60,
    "timeoutSeconds": 1800
  },
  "deploy": { "mode": "wrangler", "skipPattern": "(\\.md$|^art/|^gameplay/)" },
  "reports": {
    "project": "Chibi",
    "scheduledTicks": true,
    "recipient": "game-coordinator",
    "workerParents": ["game-coordinator"]
  }
}
