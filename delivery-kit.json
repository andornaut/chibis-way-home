{
  "schema": 1,
  "git": { "main": "main", "remote": "origin", "github": "andornaut/chibis-way-home" },
  "schedule": { "departures": ["20"], "timezone": "America/Toronto" },
  "gate": {
    "image": "node:24.21.0",
    "install": "npm ci",
    "steps": [
      { "name": "check", "run": "npm run check" },
      { "name": "lint", "run": "npm run lint" },
      { "name": "test", "run": "npm test -- --maxWorkers=4" },
      { "name": "build", "run": "npm run build" },
      { "name": "pairs", "run": "npm run pairs -- verify --sample-ms 20000" },
      { "name": "art", "run": "node art/tools/build.ts --check" }
    ]
  },
  "resources": { "cpus": 4, "loadLimit": 24 },
  "ci": {
    "requiredNames": ["AI attributions", "Lint", "Test"],
    "pollSeconds": 60,
    "timeoutSeconds": 1800
  },
  "deploy": { "mode": "wrangler", "skipPattern": "(\\.md$|^art/|^gameplay/)" },
  "reports": {
    "project": "Chibi",
    "scheduledTicks": true,
    "recipient": "game-dev",
    "workerParents": ["game-dev"]
  }
}
