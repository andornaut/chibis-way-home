{
  "name": "chibis-way-home",
  "version": "0.0.1",
  "description": "Help Chibi get home after Furt, his former best friend, mails him far away.",
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.21.0"
  },
  "scripts": {
    "prepare": "husky",
    "dev": "vite",
    "build": "vite build",
    "build:deploy": "npm run check && npm test && npm run build",
    "preview": "npm run build && wrangler dev",
    "check": "tsc",
    "lint": "prettier --check . && eslint --max-warnings 0 . && markdownlint-cli2 && npm run lint:python",
    "format": "prettier --write . && eslint --fix .",
    "install:python": "bash scripts/install-python-tools.sh",
    "lint:python": "node_modules/.bin/ruff check --no-cache art/tools",
    "test": "vitest run",
    "simulate": "tsx src/sim/cli.ts",
    "reaches": "tsx src/sim/reachCli.ts",
    "deploy": "npm run build && wrangler deploy",
    "clean": "rm -rf dist .wrangler"
  },
  "dependencies": {
    "@andornaut/game-kit": "https://github.com/andornaut/game-kit/releases/download/v0.7.0/game-kit-0.7.0.tgz",
    "phaser": "^4.2.1"
  },
  "devDependencies": {
    "@andornaut/art-kit": "https://github.com/andornaut/art-kit/releases/download/v0.13.0/art-kit-0.13.0.tgz",
    "@eslint/js": "^10.0.1",
    "@jsquash/webp": "1.5.0",
    "@types/node": "^24.19.2",
    "@types/pngjs": "^6.0.5",
    "eslint": "^10.13.0",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "eslint-plugin-sort-destructure-keys": "^3.0.0",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "markdownlint-cli2": "^0.24.0",
    "pngjs": "7.0.0",
    "prettier": "^3.9.10",
    "skia-canvas": "4.0.0",
    "tsx": "4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "wrangler": "^4.151.1"
  }
}
