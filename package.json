{
  "name": "chibis-way-home",
  "version": "0.0.1",
  "description": "Help Chibi get home after Fert, his former best friend, mails him far away.",
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.21.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "npm run build && wrangler dev",
    "check": "tsc",
    "pairs": "tsx src/tools/chunkPairs.ts",
    "lint": "prettier --check . && eslint --max-warnings 0 . && markdownlint-cli2",
    "format": "prettier --write . && eslint --fix .",
    "test": "vitest run",
    "test:game-kit": "vitest run --configLoader runner src/rules/behaviourTraversalGoals.test.ts src/scenes/BootScene.test.ts",
    "simulate": "tsx src/sim/cli.ts",
    "reaches": "tsx src/sim/reachCli.ts",
    "clean": "rm -rf dist .wrangler"
  },
  "dependencies": {
    "@andornaut/game-kit": "https://github.com/andornaut/game-kit/releases/download/v0.18.0/game-kit-0.18.0.tgz",
    "phaser": "^4.2.1"
  },
  "devDependencies": {
    "@andornaut/art-kit": "https://github.com/andornaut/art-kit/releases/download/v0.22.0/art-kit-0.22.0.tgz",
    "@andornaut/delivery-kit": "https://github.com/andornaut/delivery-kit/releases/download/v2.0.0/delivery-kit-2.0.0.tgz",
    "@eslint/js": "^10.0.1",
    "@jsquash/webp": "1.5.0",
    "@types/node": "^24.19.2",
    "@types/pngjs": "^6.0.5",
    "eslint": "^10.14.0",
    "eslint-plugin-import-x": "4.17.1",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "eslint-plugin-sort-destructure-keys": "^3.0.0",
    "globals": "^17.13.0",
    "markdownlint-cli2": "^0.24.0",
    "pngjs": "7.0.0",
    "prettier": "^3.9.10",
    "skia-canvas": "4.0.0",
    "tsx": "4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "wrangler": "^4.151.1"
  },
  "overrides": {
    "@eslint/config-array": {
      "minimatch": "11.0.3"
    },
    "@typescript-eslint/typescript-estree": {
      "minimatch": "11.0.3"
    },
    "eslint": {
      "minimatch": "11.0.3"
    },
    "eslint-plugin-import-x": {
      "minimatch": "11.0.3"
    },
    "markdownlint": {
      "re2js": "2.8.7"
    },
    "micromark-extension-math": {
      "katex": "0.18.2"
    }
  }
}
