{
  "name": "chibis-way-home",
  "version": "0.0.1",
  "description": "Help Chibi get home after Fert, his former best friend, mails him far away.",
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^24.22.2 || ^26.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "./tests/container/check bundle",
    "preview": "npm run build && wrangler dev",
    "check": "./tests/container/check check",
    "typecheck": "./tests/container/check typecheck",
    "pairs": "node src/tools/chunkPairs.ts",
    "lint": "./tests/container/check lint-only",
    "format": "prettier --write . && eslint --fix .",
    "test": "./tests/container/check test",
    "test:game-kit": "vitest run --configLoader runner --no-cache --no-fsModuleCache src/rules/behaviourTraversalGoals.test.ts src/scenes/BootScene.test.ts",
    "simulate": "node src/sim/cli.ts",
    "reaches": "node src/sim/reachCli.ts",
    "clean": "rm -rf dist .wrangler",
    "prepare": "husky"
  },
  "dependencies": {
    "@andornaut/game-kit": "https://github.com/andornaut/game-kit/releases/download/v0.35.0/game-kit-0.35.0.tgz",
    "phaser": "^4.2.1"
  },
  "devDependencies": {
    "@andornaut/art-kit": "https://github.com/andornaut/art-kit/releases/download/v0.22.0/art-kit-0.22.0.tgz",
    "@andornaut/delivery-kit": "https://github.com/andornaut/delivery-kit/releases/download/v3.0.1/delivery-kit-3.0.1.tgz",
    "@eslint/js": "^10.0.1",
    "@jsquash/webp": "1.5.0",
    "@types/node": "^26.6.6",
    "@types/pngjs": "^6.0.5",
    "eslint": "^10.14.0",
    "eslint-plugin-import-x": "4.17.1",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "eslint-plugin-sort-destructure-keys": "^3.0.0",
    "globals": "^17.14.0",
    "happy-dom": "21.0.4",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "markdownlint-cli2": "0.24.0",
    "pngjs": "7.0.0",
    "prettier": "^3.10.1",
    "skia-canvas": "4.0.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0",
    "wrangler": "^4.160.1"
  },
  "overrides": {
    "@eslint/config-array": {
      "minimatch": "11.0.3"
    },
    "@typescript-eslint/typescript-estree": {
      "minimatch": "11.0.3"
    },
    "eslint": {
      "minimatch": "11.0.3"
    },
    "eslint-plugin-import-x": {
      "minimatch": "11.0.3"
    },
    "markdown-it": "15.0.3",
    "markdownlint-cli2@0.24.0": {
      "markdownlint": "0.42.1",
      "katex": "0.19.1"
    }
  }
}
