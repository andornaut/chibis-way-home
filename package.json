{
  "name": "chibis-way-home",
  "version": "0.0.1",
  "description": "Help Chibi get home after Fert, his former best friend, mails him far away.",
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^24.22.2 || ^26.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "npm run build && wrangler dev",
    "check": "tsc",
    "typecheck": "tsc",
    "pairs": "node src/tools/chunkPairs.ts",
    "lint": "shellcheck -- tests/container/admit tests/container/check tests/container/run && shellcheck --shell=sh -- .husky/pre-commit && prettier --check . && eslint --max-warnings 0 . && markdownlint-cli2",
    "format": "prettier --write . && eslint --fix .",
    "test": "vitest run",
    "test:game-kit": "vitest run --configLoader runner src/rules/behaviourTraversalGoals.test.ts src/scenes/BootScene.test.ts",
    "simulate": "node src/sim/cli.ts",
    "reaches": "node src/sim/reachCli.ts",
    "clean": "rm -rf dist .wrangler",
    "prepare": "husky"
  },
  "dependencies": {
    "@andornaut/game-kit": "https://github.com/andornaut/game-kit/releases/download/v0.32.0/game-kit-0.32.0.tgz",
    "phaser": "^4.2.1"
  },
  "devDependencies": {
    "@andornaut/art-kit": "https://github.com/andornaut/art-kit/releases/download/v0.22.0/art-kit-0.22.0.tgz",
    "@andornaut/delivery-kit": "https://github.com/andornaut/delivery-kit/releases/download/v3.0.1/delivery-kit-3.0.1.tgz",
    "@eslint/js": "^10.0.1",
    "@jsquash/webp": "1.5.0",
    "@types/node": "^26.6.6",
    "@types/pngjs": "^6.0.5",
    "eslint": "^10.14.0",
    "eslint-plugin-import-x": "4.17.1",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "eslint-plugin-sort-destructure-keys": "^3.0.0",
    "globals": "^17.13.0",
    "happy-dom": "21.0.4",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "markdownlint-cli2": "0.24.0",
    "pngjs": "7.0.0",
    "prettier": "^3.9.10",
    "skia-canvas": "4.0.0",
    "tsx": "4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.6",
    "vitest": "^5.0.5",
    "wrangler": "^4.151.1"
  },
  "overrides": {
    "@eslint/config-array": {
      "minimatch": "11.0.3"
    },
    "@typescript-eslint/typescript-estree": {
      "minimatch": "11.0.3"
    },
    "eslint": {
      "minimatch": "11.0.3"
    },
    "eslint-plugin-import-x": {
      "minimatch": "11.0.3"
    },
    "markdownlint-cli2@0.24.0": {
      "markdownlint": "0.42.1",
      "katex": "0.19.1"
    }
  }
}
