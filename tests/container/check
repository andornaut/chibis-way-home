#!/bin/sh
set -eu

# Make launches the container; native npm aliases use these same direct recipes.
category=${1:-check}
if [ "$#" -gt 0 ]; then shift; fi

# The gate installs node_modules before its steps and its image has no /opt/check; the local
# check image supplies the lockfile's dependencies to a work copy without them.
if [ ! -e node_modules ] && [ ! -L node_modules ]; then
    if [ ! -d /opt/check/node_modules ]; then
        printf '%s\n' 'node_modules is missing: run npm ci, or use the local check image.' >&2
        exit 2
    fi
    cp -R /opt/check/node_modules node_modules
fi

no_arguments() {
    if [ "$#" -gt 0 ]; then
        printf '%s does not accept additional arguments.\n' "${category}" >&2
        exit 2
    fi
}

case "${category}" in
    check)
        no_arguments "$@"
        for category in ${CHECK_TASKS:-lint test build}; do "$0" "${category}"; done
        ;;
    lint)
        no_arguments "$@"
        "$0" typecheck
        "$0" lint-only
        ;;
    typecheck)
        exec node node_modules/typescript/bin/tsc "$@"
        ;;
    lint-only)
        no_arguments "$@"
        shellcheck -- tests/container/admit tests/container/check tests/container/run
        shellcheck --shell=sh -- .husky/pre-commit
        node node_modules/prettier/bin/prettier.cjs --check .
        node node_modules/eslint/bin/eslint.js --max-warnings 0 .
        node_modules/.bin/markdownlint-cli2
        ;;
    test)
        node node_modules/vitest/vitest.mjs run --maxWorkers=4 "$@"
        node src/tools/chunkPairs.ts verify --sample-ms 20000
        ;;
    build)
        no_arguments "$@"
        "$0" bundle
        "$0" art-check
        ;;
    bundle)
        WORKERS_CI_COMMIT_SHA=${WORKERS_CI_COMMIT_SHA:-${CHECK_REVISION:-}}
        export WORKERS_CI_COMMIT_SHA
        exec node node_modules/vite/bin/vite.js build "$@"
        ;;
    art-check)
        exec node art/tools/build.ts --check "$@"
        ;;
    exec)
        if [ "$#" -eq 0 ]; then
            printf '%s\n' 'An explicit native command is required.' >&2
            exit 2
        fi
        exec "$@"
        ;;
    *)
        printf 'Unknown project check category: %s\n' "${category}" >&2
        exit 2
        ;;
esac
