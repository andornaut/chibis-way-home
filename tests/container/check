#!/bin/sh
set -eu

category=${1:-check}
if [ "$#" -gt 0 ]; then shift; fi

# The gate installs node_modules before its steps and its image has no /opt/check; the local
# check image supplies the lockfile's dependencies to a work copy without them.
if [ ! -e node_modules ] && [ ! -L node_modules ]; then
    if [ ! -d /opt/check/node_modules ]; then
        printf '%s\n' 'node_modules is missing: run npm ci, or use the local check image.' >&2
        exit 2
    fi
    cp -R /opt/check/node_modules node_modules
fi
if [ -n "${CHECK_REVISION:-}" ]; then
    export WORKERS_CI_COMMIT_SHA="${CHECK_REVISION}"
fi

run_lint() {
    npm run check
    npm run lint
}

run_test() {
    npm test -- "$@" --maxWorkers=4
    npm run pairs -- verify --sample-ms 20000
}

run_build() {
    npm run build
    node art/tools/build.ts --check
}

case "${category}" in
    exec)
        if [ "$#" -eq 0 ]; then
            printf '%s\n' 'An explicit native command is required.' >&2
            exit 2
        fi
        exec "$@"
        ;;
    test)
        run_test "$@"
        ;;
    check|lint|build)
        if [ "$#" -gt 0 ]; then
            printf '%s does not accept additional arguments.\n' "${category}" >&2
            exit 2
        fi
        if [ "${category}" = check ]; then
            run_lint
            run_test
            run_build
        else
            "run_${category}"
        fi
        ;;
    *)
        printf 'Unknown internal check category: %s\n' "${category}" >&2
        exit 2
        ;;
esac
