#!/bin/sh
set -eu

if [ ! -r /proc/loadavg ]; then
    printf '%s\n' 'Resource admission requires the current one-minute load.' >&2
    exit 75
fi
awk '
    NR == 1 {
        if ($1 !~ /^[0-9]+([.][0-9]+)?$/ || $1 >= 20) {
            print "Resource admission requires one-minute load below 20." > "/dev/stderr"
            exit 75
        }
    }
' /proc/loadavg
